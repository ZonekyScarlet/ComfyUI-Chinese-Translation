            "fps": "帧率",
            "indices": "索引",
            "scene_threshold": "场景阈值"
        },
        "outputs": {
            "guide": "引导",
            "debug": "调试"
        },
        "description": "生成AMV引导（关键帧+空白帧）。external_images可自动将图像放置在音乐节拍处（placement设为audio_beats）。将`引导`输入VAE或参考模块。"
    },
    "BFSAnime2RealBerniniConditioning": {
        "title": "BFS Bernini动漫转真实感条件生成",
        "inputs": {
            "positive": "正向",
            "negative": "负向",
            "vae": "VAE",
            "guide_video": "引导视频"
        },
        "widgets": {
            "length": "长度"
        },
        "outputs": {
            "positive": "正向",
            "negative": "负向",
            "latent": "Latent",
            "debug": "调试"
        },
        "description": "用于Bernini-R动漫转真实感LoRA的纯视频转视频（v2v）动漫→真实感条件生成。guide_video对应source_id 1（动漫画布）| 输出对应source_id 0（真实照片）。无参考模块。引导同时应用于正向和负向，因此CFG仅放大文本提示（真实照片风格），而非参考。使用适中的CFG；引导保留运动/布局。请勿将此LoRA与换脸节点配合使用：它会注入source_id 2标记，而动漫转真实感LoRA在训练中从未见过该标记。"
    },
