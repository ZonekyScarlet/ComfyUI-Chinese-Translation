{
    "BFSAmvGuideBuilder": {
        "title": "BFS AMV引导生成器",
        "inputs": {
            "video": "视频",
            "images": "图像",
            "audio": "音频"
        },
        "widgets": {
            "mode": "模式",
            "length": "长度",
            "hold": "保持",
