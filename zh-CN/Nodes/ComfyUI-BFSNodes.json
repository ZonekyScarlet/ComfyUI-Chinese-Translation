    "LTXVEditAnythingApply": {
        "title": "LTXV编辑任意内容应用",
        "inputs": {
            "model": "模型",
            "positive": "正向",
            "negative": "负向",
            "vae": "VAE",
            "latent": "Latent",
            "ref_image": "参考图像",
            "lora_name": "LoRA名称",
            "guide_frames": "引导帧",
            "ref_temporal_offset_latents": "参考时间偏移Latent"
        },
        "widgets": {
            "resize_mode": "缩放模式",
            "guide_strength": "引导强度",
            "ref_strength": "参考强度",
            "role_strength": "角色强度",
            "adaln_scale": "AdaLN缩放",
            "enable_adaln": "启用AdaLN",
            "enable_role_embedding": "启用角色嵌入",
            "debug": "调试"
        },
        "outputs": {
            "model": "模型",
            "positive": "正向",
            "negative": "负向",
            "latent": "Latent",
            "ref_image_preview": "参考图像预览"
        },
        "description": "用于视频转视频参考AdaLN LoRA的统一编辑任意内容条件生成。在单个节点中应用来自单个LoRA检查点的全部3种条件信号：① IC-LoRA序列 对参考图像和可选引导视频进行编码，将它们作为干净的条件帧附加到Latent中。在Transformer中的布局：[目标标记 | 参考标记 @ t=-1 | 引导标记 @ t=0..T] ② 角色嵌入（role_embedding.embedding.权重[0]） 在patchify_proj之前，向参考图像标记添加学习到的128维指纹，以便模型通过自注意力区分@参考图和引导帧。③ AdaLN条件生成（ref_adaln_proj: fc1 → SiLU → proj） 使用LoRA中保存的投影器形状池化参考图像Latent，通过2层MLP投影到AdaLN时间步空间，并将其添加到每个Transformer块的时间步偏置中——这是一个持久的全局外观锚点。连接在标准LoRA加载器之后，KSampler之前。"
    },
    "LTXVApplyNeutralMask": {
        "title": "LTXV应用中性遮罩",
        "inputs": {
            "image": "图像",
