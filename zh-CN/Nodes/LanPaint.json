    "LanPaint_MiniMaxAudioEncode": {
        "title": "Latent修复 MiniMax音频编码",
        "inputs": {
            "audio": "音频",
            "vae": "VAE"
        },
        "widgets": {},
        "outputs": {
            "latent": "Latent"
        },
        "description": "使用MiniMax H3音频VAE（正确布局）对音频进行编码。音频重绘遮罩通过SetLatentNoiseMask来自视频遮罩编辑器。"
    },
    "LanPaint_MiniMaxAudioDecode": {
        "title": "Latent修复 MiniMax音频解码",
